#!name=全球主流 AI 与个人智能体生态增强分流 (Global AI & Agent Rules)
#!desc=精准分流 Meta Muse、OpenAI/ChatGPT、Claude、Gemini、Grok、Perplexity、Cursor、Suno、Midjourney 及全网最新主流 AI 智能体生态，国内主流 AI 严格直连免风控。
#!author=allofights
#!system=ios
#!category=分流规则

[Rule]
# ==================== 1. Meta AI & 个人智能体生态 (Meta Muse / Meta AI / Llama) ====================
# Meta 2026 最新个人自主智能体 Muse 全链路 (核心域 / 虚拟机 / 后台通信 / 关键字匹配)
DOMAIN-SUFFIX,muse.ai,PROXY
DOMAIN-SUFFIX,muse-meta.com,PROXY
DOMAIN-KEYWORD,muse,PROXY
DOMAIN-KEYWORD,metaclaw,PROXY
# Meta 核心 AI 助手与多模态交互
DOMAIN-SUFFIX,meta.ai,PROXY
DOMAIN,imagine.meta.com,PROXY
DOMAIN,flow.meta.com,PROXY
# Meta 基础架构、账号中心与 API (解决 Muse 登录鉴权失败、虚拟机断开及跨国切线风控)
DOMAIN-SUFFIX,meta.com,PROXY
DOMAIN-SUFFIX,facebook.com,PROXY
DOMAIN-SUFFIX,fbcdn.net,PROXY
DOMAIN-SUFFIX,fbsbx.com,PROXY
DOMAIN-SUFFIX,internalfb.com,PROXY
DOMAIN-SUFFIX,llama.com,PROXY
DOMAIN,llama.meta.com,PROXY
DOMAIN-SUFFIX,ai.meta.com,PROXY
DOMAIN-SUFFIX,oculus.com,PROXY
DOMAIN-SUFFIX,m.me,PROXY
# Meta 官方 IP 范围与 ASN (含 2022-2026 最新 57.141.0.0/14 与 163.70.0.0/16)
IP-CIDR,57.141.0.0/14,PROXY,no-resolve
IP-CIDR,157.240.0.0/16,PROXY,no-resolve
IP-CIDR,31.13.0.0/16,PROXY,no-resolve
IP-CIDR,173.252.64.0/18,PROXY,no-resolve
IP-CIDR,129.134.0.0/16,PROXY,no-resolve
IP-CIDR,66.220.144.0/20,PROXY,no-resolve
IP-CIDR,163.70.0.0/16,PROXY,no-resolve
IP-CIDR,185.60.216.0/22,PROXY,no-resolve
IP-CIDR,204.15.20.0/22,PROXY,no-resolve
IP-ASN,32934,PROXY
IP-ASN,63293,PROXY

