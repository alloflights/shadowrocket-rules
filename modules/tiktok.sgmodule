#!name=TikTok 免拔卡解锁 (US 美区增强版)
#!desc=独立维护的换区规则(美国地区)，附推荐流净化和媒体保存脚本。换区效果取决于节点、账号和客户端版本；与其它地区版四选一
#!author=allofights
#!system=ios
# Shadowrocket v3.3.3 · 独立维护模块，统一纳入安全与脚本回归检查
#!category=应用解锁

[Rule]
# HTTPS 解密主机禁用 UDP/443，避免 QUIC 绕过重写 / 脚本
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,tiktokv.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,byteoversea.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,tik-tokapi.com)),REJECT
DOMAIN-KEYWORD,tiktokcdn,PROXY
DOMAIN-SUFFIX,byteoversea.com,PROXY
DOMAIN-SUFFIX,ibytedtos.com,PROXY
DOMAIN-SUFFIX,ipstatp.com,PROXY
DOMAIN-SUFFIX,muscdn.com,PROXY
DOMAIN-SUFFIX,musical.ly,PROXY
DOMAIN-SUFFIX,tik-tokapi.com,PROXY
DOMAIN-SUFFIX,tiktok.com,PROXY
DOMAIN-SUFFIX,tiktokcdn.com,PROXY
DOMAIN-SUFFIX,tiktokv.com,PROXY
USER-AGENT,TikTok*,PROXY

[URL Rewrite]
# 1. 核心 SIM 卡国家码与地区伪装 (CN -> US)
(?<=_region=)CN(?=&) US 307
(?<=&mcc_mnc=)4 2 307

# 2. 域名探测与版本引导修复 (阻断国内识别)
^(https?:\/\/(tnc|dm)[\w-]+\.\w+\.com\/.+)(\?)(.+) $1$3 302
(^https?:\/\/*\.\w{4}okv.com\/.+&.+)(\d{2}\.3\.\d)(.+) $118.0$3 302

[Script]
# TikTok 视频无水印下载与流广告净化
TikTok_增强 = type=http-response,pattern=^https?:\/\/.*\.tiktokv\.com\/aweme\/v\d\/(feed|mix\/aweme|aweme\/post|(multi\/)?aweme\/detail|follow\/feed|nearby\/feed|search\/item|general\/search\/single|hot\/search\/video\/list|aweme\/favorite),requires-body=true,max-size=5242880,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tiktok.js,script-update-interval=86400,timeout=10

[MITM]
hostname = %APPEND% *.tiktokv.com, *.byteoversea.com, *.tik-tokapi.com
