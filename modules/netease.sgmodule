#!name=网易云音乐净化
#!desc=去除网易云音乐开屏、首页 / 发现页 / 推荐页推广、搜索热词、评论区插播与弹窗。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,music.163.com)),REJECT

[URL Rewrite]
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list - reject-200
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query - reject-200
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get - reject-200
^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity - reject-200
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources - reject-200
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/resource-exposure\/config - reject-200

[Script]
netease_adblock = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(link\/(home\/framework\/tab|page\/(discovery|rcmd)\/resource\/show|position\/show\/resource|scene\/show\/resource)|ios\/upgrade\/get|search\/(default\/keyword\/list|rcmd\/keyword\/get|chart\/(list|detail)|suggest\/keyword\/get|specialkeyword\/get)|ad\/(loading\/(get|current)|get)|vip\/cashier\/tspopup\/get|vipnewcenter\/app\/resource\/newaccountpage|side-bar\/mini-program\/music-service\/account|delivery\/(deliver|batch-deliver)|yunbei\/account\/entrance\/get|creator\/musician\/reminder\/message\/get|batch),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/netease.adblock.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% interface*.music.163.com
