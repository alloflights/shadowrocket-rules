#!name=航旅纵横净化
#!desc=去除航旅纵横开屏、摇一摇跳转第三方、首页弹窗营销与浮层。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.4 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,oss.umetrip.com)),REJECT
DOMAIN,startup.umetrip.com,REJECT
DOMAIN,umestartup.umetrip.com,REJECT
DOMAIN,bda.umetrip.com,REJECT
DOMAIN,opactivity.umetrip.com,REJECT
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,discardrp.umetrip.com,REJECT

[URL Rewrite]
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite - reject-dict

[MITM]
hostname = %APPEND% oss.umetrip.com
