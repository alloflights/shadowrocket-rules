#!name=航旅纵横净化 (Umetrip Pro)
#!desc=去除航旅纵横开屏广告、摇一摇前倾跳转美团/第三方、首页弹窗营销推广与浮层
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
DOMAIN,startup.umetrip.com,REJECT
DOMAIN,umestartup.umetrip.com,REJECT
DOMAIN,bda.umetrip.com,REJECT
DOMAIN,opactivity.umetrip.com,REJECT
DOMAIN,sensors.umetrip.com.cn,REJECT
DOMAIN,discardrp.umetrip.com,REJECT
DOMAIN,oss.umetrip.com,REJECT

[URL Rewrite]
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native - reject
^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite - reject-dict

[MITM]
hostname = %APPEND% umestartup.umetrip.com, bda.umetrip.com, startup.umetrip.com, discardrp.umetrip.com, oss.umetrip.com, home.umetrip.com, umerp.umetrip.com
