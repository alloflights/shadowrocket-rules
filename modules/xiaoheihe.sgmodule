#!name=小黑盒净化
#!desc=去除小黑盒开屏广告与资讯信息流中的广告卡片。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.2.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.xiaoheihe.cn)),REJECT

[URL Rewrite]
^https:\/\/api\.xiaoheihe\.cn\/account\/get_ads_info_v2 - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/news '(. as $o | try (.result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)) catch $o)'

[MITM]
hostname = %APPEND% api.xiaoheihe.cn
