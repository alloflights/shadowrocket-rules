AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,m5.amap.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,m5-zb.amap.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,oss.amap.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,sns.amap.com)),REJECT
URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch",REJECT

[URL Rewrite]
^http:\/\/(?![^\/]*alipay)[^\/]+\/amdc\/mobileDispatch - reject
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(car-end|route-plan)\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-(assets|location)\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/(mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword)\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? - reject-dict
^https:\/\/m5\.amap\.com\/ws\/valueadded\/weather\/v2\? - reject-dict
^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/\? - reject-dict
^https:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\? - reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(order\/car\/king_toolbox_car_bubble|tips\/onscene_visual_optimization)\? - reject-dict

[Script]
amap_drive = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/perception\/drive\/(routeInfo|routePlan)\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
amap_poi = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search\/(common\/coupon\/info|poi\/detail)\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
amap_market = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
amap_search = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(homepage|mps|search\/sp|sug|tips_operation_location)\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
amap_home = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(card-service-plan-home|main-page)\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
amap_frog = type=http-response,pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/amap.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, oss.amap.com, sns.amap.com
