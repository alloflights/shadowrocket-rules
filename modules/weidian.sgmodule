# v3.3.7 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,thor.weidian.com)),REJECT

[URL Rewrite]
^https:\/\/thor\.weidian\.com\/ares\/home\.splash\/ - reject-dict
^https:\/\/thor\.weidian\.com\/ares\/app\.dialog\/ - reject-dict
^https:\/\/thor\.weidian\.com\/warlock\/recommend\.guessULike\/ - reject-dict
^https:\/\/thor\.weidian\.com\/poseidon\/exhibit\.spaceJson\/ - reject-dict
^https:\/\/thor\.weidian\.com\/feedserver\/feed\.similarRecFeeds\/ - reject-dict
^https:\/\/thor\.weidian\.com\/faith\/search\.hotRecShadowWord\/ - reject-dict
^https:\/\/thor\.weidian\.com\/faith\/search\.getProcessTopics\/ - reject-dict
^https:\/\/thor\.weidian\.com\/feedserver\/feed\.listGoodUsers\/ - reject-dict
^https:\/\/thor\.weidian\.com\/ares\/recommend\.getSpecialFocusList\/ - reject-dict
^https:\/\/thor\.weidian\.com\/ares\/collect\.recommendShop\/ - reject-dict

[MITM]
hostname = %APPEND% thor.weidian.com
