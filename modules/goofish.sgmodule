DOMAIN-SUFFIX,bankcomm.com,DIRECT
DOMAIN-SUFFIX,psbc.com,DIRECT
DOMAIN-SUFFIX,cmbchina.com,DIRECT
DOMAIN-SUFFIX,cmbimg.com,DIRECT
DOMAIN-SUFFIX,citicbank.com,DIRECT
DOMAIN-SUFFIX,cebbank.com,DIRECT
DOMAIN-SUFFIX,cmbc.com.cn,DIRECT
DOMAIN-SUFFIX,cib.com.cn,DIRECT
DOMAIN-SUFFIX,spdb.com.cn,DIRECT
DOMAIN-SUFFIX,pingan.com,DIRECT
DOMAIN-SUFFIX,pingan.com.cn,DIRECT
DOMAIN-SUFFIX,hxb.com.cn,DIRECT
DOMAIN-SUFFIX,cgbchina.com.cn,DIRECT
DOMAIN-SUFFIX,czbank.com,DIRECT
DOMAIN-SUFFIX,bankofbeijing.com.cn,DIRECT
DOMAIN-SUFFIX,bosc.cn,DIRECT
DOMAIN-SUFFIX,webank.com,DIRECT
DOMAIN-SUFFIX,zj96596.com,DIRECT
DOMAIN-SUFFIX,zjrc.com,DIRECT
DOMAIN-SUFFIX,gffunds.com.cn,DIRECT
DOMAIN-SUFFIX,nffund.com,DIRECT
DOMAIN-SUFFIX,10086.cn,DIRECT
DOMAIN-SUFFIX,chinamobile.com,DIRECT
DOMAIN-SUFFIX,10010.com,DIRECT
DOMAIN-SUFFIX,chinaunicom.cn,DIRECT
DOMAIN-SUFFIX,189.cn,DIRECT
DOMAIN-SUFFIX,chinatelecom.com.cn,DIRECT
DOMAIN-SUFFIX,3gppnetwork.org,DIRECT
DOMAIN-SUFFIX,anticheatexpert.com,DIRECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,acs.m.goofish.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,g-acs.m.goofish.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,acs.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,guide-acs.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,h5api.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,h5api.m.goofish.com)),REJECT
DOMAIN,amdc.m.taobao.com,REJECT
URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch",REJECT
DOMAIN-SUFFIX,iyes.youku.com,REJECT

[URL Rewrite]
^http:\/\/(?![^\/]*alipay)[^\/]+\/amdc\/mobileDispatch - reject
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.popup\.window - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.float\.window - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.detailpage\.search\.shade - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home\.top - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.trade\.item\.recommend\.render - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.live\.home\.ads\.material\.get - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.topic\.banner - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.wireless\.home\.xianyu(\.my)?\.awesome\.get - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.near\.by\.corner\.info - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds - reject-dict
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose - reject-200
^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.idleadv - reject-200

[Body Rewrite]
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.fun\.follow\.feed\.list\/ '(. as $o | try (.data.sections |= map(select(.cardType == 2001))) catch $o)'
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.community\/ '(. as $o | try (.data.feedsList |= map(select(.template.name == "idlefish_home_new_commodity_card" or .template.name == "idlefish_home_new_content_card"))) catch $o)'
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.newitem\.page\/ '(. as $o | try (.data.sections |= map(select(.data.clickParam.args.cardType as $ct | $ct != "banner" and $ct != "mamaAD"))) catch $o)'
http-response-jq ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.magic\.home\.page\.list\/ '(. as $o | try (del(.data.topList)) catch $o)'

[Script]
goofish_clean = type=http-response,pattern=^https?:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|(?:g-)?acs\.m\.goofish\.com|h5api\.m\.(?:taobao|goofish)\.com)\/(?:gw|h5)\/mtop\.(taobao\.(idlehome\.home\.(nextfresh|circle\.list)|idlehome\.widget\.refresh\.get|idle\.(local\.home|home\.whale\.modulet|user\.strategy\.list|playboy\.recommend|item\.recommend\.list|group\.myself\.banner|circle\.(myself\.banner|visited)|fun\.follow\.often\.visit|local\.flow\.plat\.section)|idlemtopsearch\.search(\.shade)?)|idle\.user\.page\.my\.adapter)\/,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/goofish-sr.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400
goofish_splash_cache = type=http-request,pattern=^https?:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|(?:g-)?acs\.m\.goofish\.com|h5api\.m\.(?:taobao|goofish)\.com)\/(?:gw|h5)\/mtop\.taobao\.(?:idlecommerce\.splash|idle\.local\.splash|idle\.home\.welcome)(?:[./?]|$),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ali-splash-sr.js,requires-body=0,timeout=10,script-update-interval=86400
goofish_splash_clean = type=http-response,pattern=^https?:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|(?:g-)?acs\.m\.goofish\.com|h5api\.m\.(?:taobao|goofish)\.com)\/(?:gw|h5)\/mtop\.taobao\.(?:idlecommerce\.splash|idle\.local\.splash|idle\.home\.welcome)(?:[./?]|$),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ali-splash-sr.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com, h5api.m.taobao.com, h5api.m.goofish.com
