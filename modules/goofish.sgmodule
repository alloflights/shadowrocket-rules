#!name=闲鱼去广告
#!desc=修复闲鱼去开屏失效（全局阻断 AMDC 调度，强制回落 HTTPS），去除开屏、首页运营位/广告商品、关注页/社区/新发布推广、搜索广告与底纹、悬浮球弹窗、猜你喜欢。 小火箭兼容多网关开屏响应，保留 MTop 信封；若仍出现离线缓存广告，可先清理应用内广告缓存。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.12 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
# ==================== 关键服务保护（先于第三方广告规则，防止误杀登录 / 支付 / 购票） ====================
