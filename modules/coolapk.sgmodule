#!name=酷安深度净化 (Coolapk Pro)
#!desc=去除酷安App开屏广告、首页与信息流推广卡片、数码好物带货、评论区推广与搜索热词，封杀腾讯优量汇、穿山甲等第三方广告SDK。
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
# 酷安自建与第三方广告 SDK (腾讯优量汇、穿山甲、阿里 Tanx、数美设备指纹)
DOMAIN,ad.api.coolapk.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
DOMAIN-SUFFIX,pgdt.ugdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,mi.gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,byte-ads.com,REJECT
DOMAIN-SUFFIX,shuzilm.cn,REJECT
DOMAIN-SUFFIX,checktrustworthiness.com,REJECT
DOMAIN-SUFFIX,tanx.com,REJECT

[URL Rewrite]
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200

[Script]
酷安_初始化 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/main\/init,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_首页信息流 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/main\/index.*,requires-body=1,max-size=2097152,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_数据列表 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/(page\/|main\/|feed\/)?dataList.*,requires-body=1,max-size=2097152,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_动态详情 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/feed\/detail,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_评论区 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/feed\/replyList,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_个人中心 = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/account\/profile,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0

[MITM]
hostname = %APPEND% api.coolapk.com
