#!name=酷安深度净化 (Coolapk Pro)
#!desc=去除酷安App开屏广告、首页与信息流推广卡片、数码好物带货、评论区推广与搜索热词，封杀腾讯优量汇、穿山甲等第三方广告SDK。
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]

# --- 腾讯优量汇/GDT、素材 CDN、腾讯音乐与京东 JAD 防绕过 ---
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,c.gdt.qq.com,REJECT
DOMAIN,v.gdt.qq.com,REJECT
DOMAIN,win.gdt.qq.com,REJECT
DOMAIN,t.gdt.qq.com,REJECT
DOMAIN,a.gdt.qq.com,REJECT
DOMAIN,api.gdt.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN-SUFFIX,adnet.qq.com,REJECT
DOMAIN,api.adnet.qq.com,REJECT
DOMAIN,test-api.adnet.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,ad.qq.com,REJECT
DOMAIN-SUFFIX,qzs.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
DOMAIN-SUFFIX,pgdt.ugdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.ugdtimg.com,REJECT
DOMAIN-SUFFIX,splashqzs.gdtimg.com,REJECT
DOMAIN-SUFFIX,qzs.gdtimg.com,REJECT
DOMAIN-SUFFIX,v2.gdt.qq.com,REJECT
DOMAIN-SUFFIX,tangram.e.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN-SUFFIX,gtimg.cn,REJECT
DOMAIN-SUFFIX,beacon.qq.com,REJECT
DOMAIN-SUFFIX,otheve.beacon.qq.com,REJECT
DOMAIN-SUFFIX,btrace.qq.com,REJECT
DOMAIN-SUFFIX,adsmind.apdcdn.tc.qq.com,REJECT
DOMAIN-SUFFIX,tmead.y.qq.com,REJECT
DOMAIN-SUFFIX,tmeadquic.y.qq.com,REJECT
DOMAIN-SUFFIX,ad.tencentmusic.com,REJECT
DOMAIN-SUFFIX,adstats.tencentmusic.com,REJECT
DOMAIN-SUFFIX,jadyun.com,REJECT
DOMAIN-SUFFIX,jad.jd.com,REJECT
DOMAIN-SUFFIX,dsp-x.jd.com,REJECT
DOMAIN-SUFFIX,ad.jd.com,REJECT
IP-CIDR,119.29.29.98/32,REJECT,no-resolve
IP-CIDR,119.29.29.90/32,REJECT,no-resolve
IP-CIDR,119.29.29.88/32,REJECT,no-resolve
IP-CIDR,119.28.28.98/32,REJECT,no-resolve
IP-CIDR,119.28.28.90/32,REJECT,no-resolve
IP-CIDR,182.254.116.117/32,REJECT,no-resolve
IP-CIDR,182.254.118.118/32,REJECT,no-resolve
IP-CIDR,182.254.116.0/24,REJECT,no-resolve
IP-CIDR,182.254.118.0/24,REJECT,no-resolve

# 酷安自建与第三方广告联盟 SDK (腾讯优量汇、穿山甲 GroMore、快手、百青藤、Sigmob、阿里 Tanx、数美设备指纹)
DOMAIN,ad.api.coolapk.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle-ads.com,REJECT
DOMAIN-SUFFIX,byte-ads.com,REJECT
DOMAIN-SUFFIX,gromore.com,REJECT
DOMAIN-SUFFIX,adukwai.com,REJECT
DOMAIN-SUFFIX,e.kuaishou.com,REJECT
DOMAIN-SUFFIX,open.kuaishouzt.com,REJECT
DOMAIN-SUFFIX,kuaishouzt.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,mobads-logs.baidu.com,REJECT
DOMAIN-SUFFIX,sigmob.cn,REJECT
DOMAIN-SUFFIX,sigmob.com,REJECT
DOMAIN-SUFFIX,toponad.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,rayjump.com,REJECT
DOMAIN-SUFFIX,shuzilm.cn,REJECT
DOMAIN-SUFFIX,checktrustworthiness.com,REJECT
DOMAIN-SUFFIX,tanx.com,REJECT
DOMAIN-SUFFIX,alimama.com,REJECT
DOMAIN-SUFFIX,alimama.cn,REJECT
DOMAIN-SUFFIX,alimama.net,REJECT
DOMAIN-SUFFIX,alimama.alicdn.com,REJECT
DOMAIN-SUFFIX,atanx.alicdn.com,REJECT
DOMAIN-SUFFIX,atanx2.alicdn.com,REJECT
DOMAIN-SUFFIX,alimm.com,REJECT
DOMAIN-SUFFIX,strip.taobaocdn.com,REJECT
DOMAIN-SUFFIX,umeng.com,REJECT
DOMAIN-SUFFIX,umengcloud.com,REJECT
DOMAIN-SUFFIX,volces.com,REJECT

# 封死移动解析 HTTPDNS (防止广告 SDK 直连 IP 绕过域名规则偷跑开屏广告)
DOMAIN-SUFFIX,httpdns.baidubce.com,REJECT

[URL Rewrite]
^https?:\/\/api\d*\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200
^https?:\/\/image\.coolapk\.com\/.*(splash|advert).* - reject-img

[Script]
酷安_开屏Mock = type=http-request,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/(?:(?:main\/)?(?:splash|launch|launch_ad|launch-ad|launchad|openScreen|openscreen|open-screen|open_screen|startup|startup_ad|startup-ad|startupad|boot_ad|boot-ad|bootad)|ad\/request)(?:[\/?]|$),requires-body=0,max-size=0,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_初始化 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/main\/init,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_首页信息流 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/(?:main|feed)\/index.*,requires-body=1,max-size=2097152,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_数据列表 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/(?:page|main|feed)\/(?:dataList|list|feedList|stream).*,requires-body=1,max-size=2097152,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_动态详情 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/feed\/detail,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_评论区 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/feed\/replyList,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0
酷安_个人中心 = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/account\/profile,requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,script-update-interval=0

[MITM]
hostname = %APPEND% api.coolapk.com, api2.coolapk.com, *.coolapk.com
