#!name=酷安去广告
#!desc=彻底去除酷安开屏（不再出现空白开屏与“跳过”按钮）、热启动开屏、首页/动态详情/评论区赞助卡片与热搜。首次启用后请删除重装酷安一次。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.5 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.coolapk.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api2.coolapk.com)),REJECT
DOMAIN,ad.api.coolapk.com,REJECT

[URL Rewrite]
^https?:\/\/api\d*\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-dict

[Script]
coolapk_init_req = type=http-request,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/main\/init,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,requires-body=0,timeout=10,script-update-interval=86400
coolapk_init = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/main\/init,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
coolapk_feed = type=http-response,pattern=^https?:\/\/api\d*\.coolapk\.com\/v6\/(main\/(indexV\d+|dataList)|page\/dataList|feed\/(detail|replyList|index)),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/coolapk.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% api.coolapk.com, api2.coolapk.com
