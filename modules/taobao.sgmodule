AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,acs.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,guide-acs.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,poplayer.template.alibaba.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,acs.m.goofish.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,g-acs.m.goofish.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,h5api.m.taobao.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,h5api.m.goofish.com)),REJECT
DOMAIN,amdc.m.taobao.com,REJECT
URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch",REJECT
DOMAIN,adashx.m.taobao.com,REJECT
DOMAIN,h-adashx.ut.taobao.com,REJECT
DOMAIN,ut.taobao.com,REJECT
DOMAIN,ossgw.alicdn.com,REJECT
DOMAIN,hudong.alicdn.com,REJECT
DOMAIN,ems.youku.com,REJECT

[URL Rewrite]
^http:\/\/(?![^\/]*alipay)[^\/]+\/amdc\/mobileDispatch - reject
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict) - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.(queryadvertise|queryloadingbanner) - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.popup\.get\/ - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.tripzoo\.new\.couponlist\/ - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.my\.recommendcard\/ - reject-dict
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.recommend\.common\.guess\.tab\.feeds\/ - reject-dict
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get) - reject-dict

[Script]
taobao_splash_cache = type=http-request,pattern=(?:(?:^https?:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|(?:g-)?acs\.m\.goofish\.com|h5api\.m\.(?:taobao|goofish)\.com)\/(?:gw|h5)\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:[/?]|$)|^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.cloudvideo\.video\.query(?:[/?]|$))|^https:\/\/poplayer\.template\.alibaba\.com\/[^/?]+\.json(?:[?]|$)),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ali-splash-sr.js,requires-body=0,timeout=10,script-update-interval=86400
taobao_splash_clean = type=http-response,pattern=(?:(?:^https?:\/\/(?:acs\.m\.taobao\.com|guide-acs\.m\.taobao\.com|(?:g-)?acs\.m\.goofish\.com|h5api\.m\.(?:taobao|goofish)\.com)\/(?:gw|h5)\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:[/?]|$)|^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.cloudvideo\.video\.query(?:[/?]|$))|^https:\/\/poplayer\.template\.alibaba\.com\/[^/?]+\.json(?:[?]|$)),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ali-splash-sr.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% acs.m.taobao.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com, acs.m.goofish.com, g-acs.m.goofish.com, h5api.m.taobao.com, h5api.m.goofish.com
