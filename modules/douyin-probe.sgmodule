#!name=抖音推荐接口测试（临时）
#!desc=临时测试用：只读取抖音推荐接口并记录格式与带链接视频的字段，不删除、不修改任何内容。测完请关闭。可能导致推荐页或评论暂时加载失败，关闭模块即可恢复。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=测试
#!system=ios

[Rule]
# HTTPS 解密主机禁用 UDP/443，避免 QUIC 绕过脚本
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,amemv.com)),REJECT

[Script]
抖音_推荐接口只读测试 = type=http-response,pattern=^https:\/\/(?:api|aggr)\d*-normal-[^\/]+\.amemv\.com\/,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/douyin-probe-sr.js,requires-body=1,max-size=5242880,timeout=10,script-update-interval=86400
抖音_测试报告 = type=http-request,pattern=^https:\/\/api5-normal-zb\.amemv\.com\/__sr_probe__\/,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/douyin-probe-sr.js,requires-body=0,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% api*-normal-*.amemv.com, aggr*-normal-*.amemv.com
