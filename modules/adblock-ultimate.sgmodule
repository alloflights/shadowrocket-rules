# --- 闲鱼去广告 ---
goofish_clean = type=http-response,pattern=^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.(taobao\.(idlehome\.home\.(nextfresh|circle\.list)|idlehome\.widget\.refresh\.get|idle\.(local\.home|home\.whale\.modulet|user\.strategy\.list|playboy\.recommend|item\.recommend\.list|group\.myself\.banner|circle\.(myself\.banner|visited)|fun\.follow\.often\.visit|local\.flow\.plat\.section)|idlemtopsearch\.search(\.shade)?)|idle\.user\.page\.my\.adapter)\/,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/goofish.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

# --- 网易云音乐净化 ---
netease_adblock = type=http-response,pattern=^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(link\/(home\/framework\/tab|page\/(discovery|rcmd)\/resource\/show|position\/show\/resource|scene\/show\/resource)|ios\/upgrade\/get|search\/(default\/keyword\/list|rcmd\/keyword\/get|chart\/(list|detail)|suggest\/keyword\/get|specialkeyword\/get)|ad\/(loading\/(get|current)|get)|vip\/cashier\/tspopup\/get|vipnewcenter\/app\/resource\/newaccountpage|side-bar\/mini-program\/music-service\/account|delivery\/(deliver|batch-deliver)|yunbei\/account\/entrance\/get|creator\/musician\/reminder\/message\/get|batch),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/netease.adblock.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

# --- 完美世界电竞净化 ---
