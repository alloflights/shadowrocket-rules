safari_clean = type=http-response,pattern=^https?:\/\/(m\.zhihu\.com\/(question\/\d+|p\/\d+)|blog\.csdn\.net\/\w+\/article\/details\/\d+|tieba\.baidu\.com\/p\/\d+|m\.weibo\.cn\/detail\/\d+),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/safari-clean.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

# --- 微博净化 ---
weibo_main = type=http-response,pattern=^https?:\/\/api\.weibo\.cn\/2\/(cardlist|page|statuses\/(container_timeline|extend|show)|checkin\/show|client\/publisher_list|push\/active|groups\/allgroups\/v2|comments\/build_comments|profile\/(container_timeline|me|userinfo)|search\/(container_timeline|finder)|video\/tiny_stream_video_list),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/weibo.js,requires-body=1,max-size=2097152,timeout=30,script-update-interval=86400
weibo_preload = type=http-response,pattern=^https?:\/\/(sdkapp|bootpreload|wbapp)\.uve\.weibo\.com\/(interface\/sdk\/sdkad\.php|v[12]\/ad\/preload|wbapplua\/wbpullad\.lua|preload\/get_ad),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/weibo.js,requires-body=1,max-size=1048576,timeout=30,script-update-interval=86400

# --- 小红书净化 ---
xiaohongshu_purify = type=http-response,pattern=^https?:\/\/(edith|rec|www|so)\.(xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(note\/comment\/(list|sub_comments)|note\/(imagefeed|feed|videofeed|widgets|live_photo\/save|video\/save|detail)|homefeed|system_service\/(splash_config|config)|search\/(banner_list|hot_list|hint|trending|notes)|followfeed),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/xiaohongshu-sr.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

# --- 喜马拉雅净化 ---
ximalaya_clean = type=http-response,pattern=^https?:\/\/.*\.xima.*\.com\/(discovery-category\/(customCategories|v\d\/category)|focus-mobile\/focusPic|discovery-feed\/v\d\/mix|mobile-user\/v\d\/homePage),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ximalaya_json.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

# --- 知乎净化 ---
zhihu_clean = type=http-response,pattern=^https?:\/\/(api|www|appcloud2|appcloud2\.in|zhuanlan)\.zhihu\.com\/(feed-root\/|topstory\/recommend|v4\/topstory\/recommend|(?:v4\/)?topstory\/hot-lists|moments|(api\/)?v4\/questions\/\d+\/(answers|feeds)|questions\/\d+\/(answers|feeds)|(api\/)?v4\/answers\/\d+|answers\/(?:v2\/)?\d+|(api\/)?v4\/articles\/\d+|articles\/(?:v2\/)?\d+|next-data|next-render|prague\/|comment_v5\/|v4\/comments|search\/preset_words|search\/tabs|(v4\/)?search_v3|ad-style-service\/|commercial_api\/|(api\/v4\/)?(mcn|bazaar|ecommerce|fringe)\/|v3\/resource|v3\/config),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/zhihu-sr.js,requires-body=1,max-size=5242880,timeout=10,script-update-interval=86400


