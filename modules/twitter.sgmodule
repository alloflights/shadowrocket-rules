#!name=X (Twitter) 与海外流媒体纯净去广告 (X & Overseas Streaming Pro)
#!desc=深度拦截 X (Twitter) 信息流推广推文(Promoted Tweets)、评论区插播广告、热搜商业词条，同时覆盖 Twitch、Spotify、Reddit、Pixiv 等海外流媒体广告与追踪域名
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
# 1. X (Twitter) 商业广告分发与遥测追踪
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,ads-api.x.com,REJECT
DOMAIN,ads.twitter.com,REJECT
DOMAIN,ads.x.com,REJECT
DOMAIN,analytics.twitter.com,REJECT
DOMAIN,analytics.x.com,REJECT
DOMAIN,static.ads-twitter.com,REJECT
DOMAIN,scribe.twitter.com,REJECT
DOMAIN,scribe.x.com,REJECT
DOMAIN,p.twitter.com,REJECT
DOMAIN,syndication.twitter.com,REJECT
DOMAIN,syndication-oembed.twitter.com,REJECT

# 2. Spotify 音频流广告与打点拦截
DOMAIN,ads-fa.spotify.com,REJECT
DOMAIN,adstudio.spotify.com,REJECT
DOMAIN,adeventtracker.spotify.com,REJECT
DOMAIN,analytics.spotify.com,REJECT
DOMAIN,crashdump.spotify.com,REJECT
DOMAIN,log.spotify.com,REJECT
DOMAIN,weblb-wg.gslb.spotify.com,REJECT

# 3. Twitch / Reddit / Pixiv / Instagram 商业广告与打点拦截
DOMAIN,ads.reddit.com,REJECT
DOMAIN,events.reddit.com,REJECT
DOMAIN,events.redditmedia.com,REJECT
DOMAIN,d.reddit.com,REJECT
DOMAIN,w3-reporting.reddit.com,REJECT
DOMAIN,ad.pixiv.org,REJECT
DOMAIN,d.pixiv.org,REJECT
DOMAIN,imp.pixiv.net,REJECT
DOMAIN,analytics.pixiv.net,REJECT
DOMAIN,imasdk.googleapis.com,REJECT
DOMAIN-SUFFIX,scorecardresearch.com,REJECT

[URL Rewrite]
# X (Twitter) 广告接口与埋点重写
^https?:\/\/(api\.)?(twitter|x)\.com\/(1\.1|2)\/(ads|promoted_content|jot|live_pipeline\/update_subscriptions) - reject-200
# Spotify 音频插播广告与逻辑拦截
^https?:\/\/spclient\.wg\.spotify\.com\/(ads|ad-logic)\/ - reject-200

[Script]
# X (Twitter) GraphQL 与 REST 时间线、推文详情评论区、搜索流及热搜推广实时剥离
twitter_clean = type=http-response,pattern=^https?:\/\/(api\.)?(twitter|x)\.com\/(graphql\/.+\/(HomeTimeline|HomeLatestTimeline|TweetDetail|SearchTimeline|UserTweets|UserTweetsAndReplies|ListLatestTweetsTimeline|CommunitiesMainDiscoveryModule|ExplorePage|GenericTimelineById)|2\/(timeline|guide|search)\/),requires-body=1,max-size=5242880,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/twitter.js,script-update-interval=0

[MITM]
hostname = %APPEND% api.twitter.com, api.x.com, twitter.com, x.com, mobile.twitter.com, mobile.x.com, spclient.wg.spotify.com
