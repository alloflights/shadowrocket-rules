#!name=抖音深度纯净版 (Douyin Pro - 网络层稳态版)
#!desc=基于真机抓包精准拦截巨量引擎与穿山甲4200+次商业打点，阻断开屏广告与小黄车配置，避开Cronet证书绑定风控，保障推荐流流畅自然无反弹。
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
# 穿山甲移动广告联盟与竞价体系 (Pangolin SDK) - 抓包已命中 4200+ 次
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle-ads.com,REJECT
DOMAIN-SUFFIX,byte-ads.com,REJECT

# 巨量引擎、数据统计与行为埋点打点 (OceanEngine & Log)
DOMAIN-SUFFIX,oceanengine.com,REJECT
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,ad.zijieapi.com,REJECT
DOMAIN-SUFFIX,analytics.snssdk.com,REJECT
DOMAIN-SUFFIX,log.snssdk.com,REJECT
DOMAIN-SUFFIX,applog.snssdk.com,REJECT
DOMAIN-SUFFIX,toblog.ctobsnssdk.com,REJECT
DOMAIN-SUFFIX,mon.snssdk.com,REJECT
DOMAIN-SUFFIX,apm.snssdk.com,REJECT
DOMAIN-SUFFIX,log0-misc-lf.amemv.com,REJECT
DOMAIN-SUFFIX,mon0-misc-lf.amemv.com,REJECT
DOMAIN-SUFFIX,logbk.amemv.com,REJECT

# 抖音电商小黄车、商品详情、SKU与规格弹窗深度绞杀 (彻底解决图1规格详情与小黄车)
DOMAIN-SUFFIX,ecombdapi.com,REJECT
DOMAIN-SUFFIX,ecombdpage.com,REJECT
DOMAIN-SUFFIX,ecombdimg.com,REJECT
DOMAIN-SUFFIX,ecombdstatic.com,REJECT
DOMAIN,ecomuser.snssdk.com,REJECT
DOMAIN-SUFFIX,render.ecombdpage.com,REJECT

# 字节端侧智能投放大脑、广告转化归因与动态分流 (Pitaya & Polaris & MSSDK)
DOMAIN,pitaya.bytedance.com,REJECT
DOMAIN-SUFFIX,polaris5-normal-zb.zijieapi.com,REJECT
DOMAIN-SUFFIX,polaris.zijieapi.com,REJECT
DOMAIN-SUFFIX,abtest3-misc-lf.zijieapi.com,REJECT
DOMAIN-SUFFIX,mssdk3-normal-lf.zijieapi.com,REJECT
DOMAIN-SUFFIX,neptune-api.volces.com,REJECT
DOMAIN-SUFFIX,wmzfylgdsz.com,REJECT

# 直播间推流、直播带货卡片与同城直播强插 (Webcast - 杀错不放过)
DOMAIN-KEYWORD,webcast,REJECT
DOMAIN-SUFFIX,bytegecko.com,REJECT

# 广告资源与行为埋点
DOMAIN-KEYWORD,ad-pattern,REJECT-IMG
DOMAIN-KEYWORD,toblog,REJECT

[URL Rewrite]
# 开屏广告与启动配置全拦截
^https?:\/\/.*\.snssdk\.com\/v\d\/splash\/ - reject-dict
^https?:\/\/(api.*\.amemv|aweme\.snssdk)\.com\/api\/ad\/ - reject-200
^https?:\/\/.*\.snssdk\.com\/api\/ad\/v\d\/ - reject-200

# 视频内带货小黄车、商品浮窗与商业推广
^https?:\/\/.*\.snssdk\.com\/aweme\/v\d\/yellow_cart\/ - reject-dict
^https?:\/\/.*\.snssdk\.com\/aweme\/v\d\/commerce\/ - reject-dict
^https?:\/\/.*\.snssdk\.com\/live\/room\/pop_window - reject-dict
^https?:\/\/.*\.ecombdapi\.com\/.* - reject-200
^https?:\/\/.*\.ecombdpage\.com\/.* - reject-200

[MITM]
# 抖音客户端采用 Chromium Cronet 强证书校验 (SSL Pinning)，严禁对 amemv API 域名强开解密，避免触发字节安全降级机制导致底模商业广告轰炸
hostname = %APPEND% -*
