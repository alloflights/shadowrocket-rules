#!name=外链直接跳转
#!desc=自动跳过知乎、CSDN、掘金、简书、微博、贴吧、QQ、少数派、Gitee、语雀的外链安全确认页。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=浏览增强
#!system=ios
# v3.2.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,link.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,link.csdn.net)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,link.juejin.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,www.jianshu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,weibo.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,jump.bdimg.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,jump2.bdimg.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,c.pc.qq.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,sspai.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,gitee.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,www.yuque.com)),REJECT

[Script]
direct_link = type=http-request,pattern=^https?:\/\/(link\.(zhihu\.com|csdn\.net|juejin\.cn)|www\.jianshu\.com\/go-wild|weibo\.cn\/sinaurl|jump2?\.bdimg\.com\/safecheck|c\.pc\.qq\.com\/middlem|sspai\.com\/link|gitee\.com\/link|www\.yuque\.com\/r\/goto),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/direct-link.js,requires-body=0,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% link.zhihu.com, link.csdn.net, link.juejin.cn, www.jianshu.com, weibo.cn, jump.bdimg.com, jump2.bdimg.com, c.pc.qq.com, sspai.com, gitee.com, www.yuque.com
