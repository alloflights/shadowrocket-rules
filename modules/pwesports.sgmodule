#!name=完美世界电竞净化
#!desc=去除完美世界电竞开屏、社区与资讯信息流推广、轮播横幅与弹窗。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.11 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.pwesports.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,app.pwesports.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,client.pwesports.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,esports.wanmei.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.esports.wanmei.com)),REJECT
DOMAIN,ad.pwesports.cn,REJECT
DOMAIN,advert.pwesports.cn,REJECT
DOMAIN,analytics.wanmei.com,REJECT
DOMAIN,log.pwesports.cn,REJECT
DOMAIN,tracker.pwesports.cn,REJECT
DOMAIN,tracking.pwesports.cn,REJECT
DOMAIN,stat.esports.wanmei.com,REJECT
DOMAIN,log-sdk.wanmei.com,REJECT
DOMAIN-SUFFIX,telemetry.wanmei.com,REJECT

[URL Rewrite]
^https?:\/\/((api|app|client)\.pwesports\.cn|(api\.)?esports\.wanmei\.com)\/.*(feed\/ad|promote|popup|banner_ad) - reject-dict

[Script]
pwesports_splash = type=http-request,pattern=^https?:\/\/((api|app|client)\.pwesports\.cn|(api\.)?esports\.wanmei\.com)\/.*(splash|startup|launch|advert|open_screen|boot_ad),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/pwesports.js,requires-body=0,timeout=10,script-update-interval=86400
pwesports_clean = type=http-response,pattern=^https?:\/\/((api|app|client)\.pwesports\.cn|(api\.)?esports\.wanmei\.com)\/(app|api)\/(v\d\/)?(feed|news|community|home|banner|match|article|square|post|index),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/pwesports.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% api.pwesports.cn, app.pwesports.cn, client.pwesports.cn, esports.wanmei.com, api.esports.wanmei.com
