#!name=知乎净化
#!desc=去除知乎开屏、推荐/关注/热榜流广告、回答页与评论区商品卡、搜索预置词与商业横幅。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.11 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,www.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,appcloud2.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,appcloud2.in.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,zhuanlan.zhihu.com)),REJECT
DOMAIN,sugar.zhihu.com,REJECT
DOMAIN,zhihu-web-analytics.zhihu.com,REJECT
DOMAIN,datahub.zhihu.com,REJECT
DOMAIN,crash2.zhihu.com,REJECT
DOMAIN,apm.zhihu.com,REJECT
IP-CIDR,118.89.204.198/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/(api|www)\.zhihu\.com\/commercial_api\/(banners_v3|launch_v2|app_float_layer|feed_float_layer)\/? - reject-dict
^https?:\/\/(api|www)\.zhihu\.com\/(api\/v4\/)?(mcn|bazaar|ecommerce|fringe)\/ - reject-dict
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:answer|article)\/\d+\/bottom-v2\/?(?:[?#]|$) - reject-dict
^https?:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\/?(?:[?#]|$) - reject-dict

[Script]
zhihu_clean = type=http-response,pattern=^https?:\/\/(api|www|appcloud2|appcloud2\.in|zhuanlan)\.zhihu\.com\/(feed-root\/|topstory\/recommend|v4\/topstory\/recommend|(?:v4\/)?topstory\/hot-lists|moments|(api\/)?v4\/questions\/\d+\/(answers|feeds)|questions\/\d+\/(answers|feeds)|(api\/)?v4\/answers\/\d+|answers\/(?:v2\/)?\d+|(api\/)?v4\/articles\/\d+|articles\/(?:v2\/)?\d+|next-data|next-render|prague\/|comment_v5\/|v4\/comments|search\/preset_words|search\/tabs|(v4\/)?search_v3|ad-style-service\/|commercial_api\/|(api\/v4\/)?(mcn|bazaar|ecommerce|fringe)\/|v3\/resource|v3\/config),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/zhihu-sr.js,requires-body=1,max-size=5242880,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% api.zhihu.com, www.zhihu.com, appcloud2.zhihu.com, appcloud2.in.zhihu.com, zhuanlan.zhihu.com
