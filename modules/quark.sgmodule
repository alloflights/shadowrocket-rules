#!name=夸克净化
#!desc=去除夸克首页推送横幅、胶囊入口、节日样式、会员与网盘活动弹窗、抽奖 / 福利 / 优惠券推广、小说与视频广告位配置；拒绝书城资源位下发。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.2.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,open-cms-api.quark.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,stars.shuqireader.com)),REJECT

[URL Rewrite]
^https:\/\/stars\.shuqireader\.com\/kkios\/render\/load\/resource\/(app|appConfig)$ - reject-dict

[Body Rewrite]
