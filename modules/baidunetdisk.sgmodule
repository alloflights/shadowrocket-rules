#!name=百度网盘净化 (Baidu Netdisk)
#!desc=彻底去除百度网盘开屏广告、摇一摇跳转美团/第三方、横幅推广、福利活动弹窗、会员推广、首页信息流推广、短剧与日志统计上报
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
# 1. 百度移动广告 SDK (Baidu MobAds / 百青藤 / 百度联盟)
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,mobads-logs.baidu.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.cn,REJECT
DOMAIN-SUFFIX,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,afd.baidu.com,REJECT
DOMAIN-SUFFIX,afd-conf.baidu.com,REJECT
DOMAIN-SUFFIX,als.baidu.com,REJECT
DOMAIN-SUFFIX,baichuan.baidu.com,REJECT
DOMAIN-SUFFIX,pos.baidu.com,REJECT
DOMAIN-SUFFIX,cpro.baidu.com,REJECT
DOMAIN-SUFFIX,cbjs.baidu.com,REJECT
DOMAIN-SUFFIX,cpu.baidu.com,REJECT
DOMAIN-SUFFIX,caclick.baidu.com,REJECT
DOMAIN-SUFFIX,eclick.baidu.com,REJECT
DOMAIN,update.pan.baidu.com,REJECT
DOMAIN,fc-video.cdn.bcebos.com,REJECT
DOMAIN,rp.hpplay.cn,REJECT

# 2. 百度 HTTPDNS 域名阻断 (防止应用直连 IP 绕过广告分流与重写)
DOMAIN-SUFFIX,httpdns.baidubce.com,REJECT
DOMAIN-SUFFIX,httpdns.baidu.com,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

# 3. 聚合第三方广告联盟 SDK (穿山甲 / 优量汇 / 快手 / 西柚 / 掌驭，拦截开屏摇一摇跳转美团等广告)
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
DOMAIN-SUFFIX,pgdt.ugdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,mi.gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,sigmob.cn,REJECT
DOMAIN-SUFFIX,sigmob.com,REJECT
DOMAIN-SUFFIX,toponad.com,REJECT
DOMAIN-SUFFIX,appnext.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,rayjump.com,REJECT
DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT
DOMAIN-SUFFIX,zhangyuyidong.com,REJECT
DOMAIN-SUFFIX,adukwai.com,REJECT
DOMAIN-SUFFIX,e.kuaishou.com,REJECT
DOMAIN-SUFFIX,open.e.kuaishou.com,REJECT
DOMAIN-SUFFIX,impdsp.meituan.com,REJECT

[URL Rewrite]
# 百度网盘开屏与核心配置广告拦截 (开屏/启动引导/系统配置)
^https?:\/\/pan\.baidu\.com\/buy\/ad\/conf - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/getsyscfg - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/getconfig - reject-dict
^https?:\/\/pan\.baidu\.com\/rest\/.*\/membership\/(proxy\/)?guide - reject-200

# 百度网盘核心广告与营销弹窗拦截 (拦截福利/美团优惠券/活动弹窗)
^https?:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adx - reject-dict
^https?:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/ad - reject-dict
^https?:\/\/pan\.baidu\.com\/rest\/.+\/pcs\/adx - reject-dict
^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list - reject-dict
^https?:\/\/pan\.baidu\.com\/act\/.+\/bchannel\/list - reject-dict
^https?:\/\/pan\.baidu\.com\/act\/api\/activityentry - reject-dict
^https?:\/\/pan\.baidu\.com\/pmall\/order\/privilege\/info - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/useractivity\/activity - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/certuser\/get - reject-dict
^https?:\/\/pan\.baidu\.com\/component\/view\/(1510|1130)\?vip - reject-dict

# 百度网盘首页信息流、短剧与活动推广
^https?:\/\/pan\.baidu\.com\/feed\/cardinfos - reject-dict
^https?:\/\/pan\.baidu\.com\/feed\/hotlist - reject-200
^https?:\/\/pan\.baidu\.com\/recommend\/shortseries\/list - reject-dict
^https?:\/\/pan\.baidu\.com\/coins\/center\/notice - reject-200
^https?:\/\/pan\.baidu\.com\/queryintent\/queryhint - reject-200
^https?:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist - reject-dict

# 百度网盘静态资源与打点
^https?:\/\/ndstatic\.cdn\.bcebos\.com\/activity\/welfare\/(js\/.+\.js|index\.html) - reject-200
^https?:\/\/staticsns\.cdn\.bcebos\.com\/amis\/.+\/banner\.png - reject-img
^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao - reject-200
^https?:\/\/update\.pan\.baidu\.com\/statistics - reject-200
^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk - reject-200
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-dict

[MITM]
hostname = %APPEND% pan.baidu.com, afd.baidu.com, ndstatic.cdn.bcebos.com, staticsns.cdn.bcebos.com
