#!name=百度网盘净化 (Baidu Netdisk Pro)
#!desc=彻底去除百度网盘开屏广告、杜绝白屏与5秒倒计时、拦截横幅推广、福利弹窗、短剧与信息流推广
#!author=allofights
#!system=ios
#!category=应用净化

[Rule]
DOMAIN,sofire.baidu.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,mobads-logs.baidu.com,REJECT
DOMAIN-SUFFIX,mobads.baidu.cn,REJECT
DOMAIN-SUFFIX,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN-SUFFIX,afd.baidu.com,REJECT
DOMAIN-SUFFIX,afd-conf.baidu.com,REJECT
DOMAIN-SUFFIX,als.baidu.com,REJECT
DOMAIN-SUFFIX,baichuan.baidu.com,REJECT
DOMAIN-SUFFIX,pos.baidu.com,REJECT
DOMAIN-SUFFIX,cpro.baidu.com,REJECT
DOMAIN-SUFFIX,cbjs.baidu.com,REJECT
DOMAIN-SUFFIX,cpu.baidu.com,REJECT
DOMAIN-SUFFIX,caclick.baidu.com,REJECT
DOMAIN-SUFFIX,eclick.baidu.com,REJECT
DOMAIN-SUFFIX,sugar.baidu.com,REJECT
DOMAIN,update.pan.baidu.com,REJECT
DOMAIN,fc-video.cdn.bcebos.com,REJECT
DOMAIN,rp.hpplay.cn,REJECT
DOMAIN-SUFFIX,httpdns.baidubce.com,REJECT
DOMAIN-SUFFIX,httpdns.baidu.com,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve
# 穿山甲 / 巨量引擎 (Pangle / CSJ SDK - 彻底封杀摇一摇开屏广告)
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao2.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle-ads.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,csjplatform.com,REJECT
DOMAIN-SUFFIX,csjbi.com,REJECT
DOMAIN-SUFFIX,isplusurl.com,REJECT
DOMAIN-SUFFIX,bytead.net,REJECT
DOMAIN-SUFFIX,byte-ads.com,REJECT
DOMAIN,ads3-normal-lf.zijieapi.com,REJECT
DOMAIN,ads5-normal-lf.zijieapi.com,REJECT
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,v3-ad.pstatp.com,REJECT
DOMAIN,sf6-ttcdn-tos.pstatp.com,REJECT
DOMAIN,ad.oceanengine.com,REJECT
DOMAIN-SUFFIX,toblog.ctobsnssdk.com,REJECT
DOMAIN-SUFFIX,toblog.snssdk.com,REJECT

# 腾讯优量汇 / 广点通 (GDT SDK)
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
DOMAIN-SUFFIX,pgdt.ugdtimg.com,REJECT
DOMAIN-SUFFIX,tmead.y.qq.com,REJECT
DOMAIN-SUFFIX,tmeadquic.y.qq.com,REJECT

# 快手 / 西柚 / 倍孜 / TopOn / 聚合 ADX
DOMAIN-SUFFIX,kuaishouzt.com,REJECT
DOMAIN,open.e.kuaishou.cn,REJECT
DOMAIN-SUFFIX,sigmob.cn,REJECT
DOMAIN-SUFFIX,ads.sigmob.com,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT
DOMAIN-SUFFIX,toponad.com,REJECT
DOMAIN-SUFFIX,tradplusad.com,REJECT
DOMAIN-SUFFIX,adx.adintl.cn,REJECT
DOMAIN-SUFFIX,vlion.cn,REJECT
DOMAIN-SUFFIX,advlion.com,REJECT
DOMAIN-SUFFIX,ubixioe.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN-SUFFIX,shuzilm.cn,REJECT
DOMAIN-SUFFIX,checktrustworthiness.com,REJECT

[URL Rewrite]
^https?:\/\/pan\.baidu\.com\/rest\/.*\/membership\/(proxy\/)?guide - reject-200
^https?:\/\/pan\.baidu\.com\/pmall\/order\/privilege\/info - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/useractivity\/activity - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/certuser\/get - reject-dict
^https?:\/\/pan\.baidu\.com\/component\/view\/(1510|1130)\?vip - reject-dict
^https?:\/\/pan\.baidu\.com\/feed\/hotlist - reject-200
^https?:\/\/pan\.baidu\.com\/coins\/center\/notice - reject-200
^https?:\/\/pan\.baidu\.com\/queryintent\/queryhint - reject-200
^https?:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist - reject-dict
^https?:\/\/ndstatic\.cdn\.bcebos\.com\/activity\/welfare\/(js\/.+\.js|index\.html) - reject-200
^https?:\/\/staticsns\.cdn\.bcebos\.com\/amis\/.+\/banner\.png - reject-img
^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/.*(guanggao|ad|splash|advert).* - reject-img
^https?:\/\/update\.pan\.baidu\.com\/statistics - reject-200
^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk - reject-200
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-dict
^https?:\/\/pan\.baidu\.com\/buy\/ad\/analytics - reject-200
^https?:\/\/pan\.baidu\.com\/api\/analytics - reject-200

[Script]
# 百度网盘急速开屏净化 (本地 0.1ms Mock 响应，彻底阻止开屏占位页与摇一摇监听实例化)
baidunetdisk_splash = type=http-request,pattern=^https?:\/\/pan\.baidu\.com\/.*(pcs\/adx?|membership\/advertise|splash|buy\/ad\/(conf|get)|api\/ad\/|act\/(api\/activityentry|v\d\/(bchannel|welfare)\/list)|feed\/cardinfos|recommend\/shortseries\/list),requires-body=0,max-size=0,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/baidunetdisk.js,script-update-interval=0
# 百度网盘响应流数据净化 (剥离 GroMore/穿山甲瀑布流配置、横幅、推广与信息流卡片)
baidunetdisk_clean = type=http-response,pattern=^https?:\/\/pan\.baidu\.com\/.*(feed|card|membership|activity|config|user|welfare),requires-body=1,max-size=2097152,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/baidunetdisk.js,script-update-interval=0

[MITM]
hostname = %APPEND% pan.baidu.com, afd.baidu.com, ndstatic.cdn.bcebos.com, staticsns.cdn.bcebos.com, issuecdn.baidupcs.com
