#!name=百度网盘净化
#!desc=去除百度网盘开屏与倒计时、首页卡片推广、会员引导、福利活动与热榜，清洗 getsyscfg 广告配置；不触碰文件列表。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.1.0 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,pan.baidu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,ndstatic.cdn.bcebos.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,staticsns.cdn.bcebos.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,issuecdn.baidupcs.com)),REJECT
DOMAIN,update.pan.baidu.com,REJECT
DOMAIN,fc-video.cdn.bcebos.com,REJECT
DOMAIN,rp.hpplay.cn,REJECT
DOMAIN-SUFFIX,afd.baidu.com,REJECT

[URL Rewrite]
^https?:\/\/pan\.baidu\.com\/rest\/.*\/membership\/(proxy\/)?guide - reject-200
^https?:\/\/pan\.baidu\.com\/pmall\/order\/privilege\/info - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/useractivity\/activity - reject-dict
^https?:\/\/pan\.baidu\.com\/api\/certuser\/get - reject-dict
^https?:\/\/pan\.baidu\.com\/component\/view\/(1510|1130)\?vip - reject-dict
^https?:\/\/pan\.baidu\.com\/feed\/hotlist - reject-200
^https?:\/\/pan\.baidu\.com\/coins\/center\/notice - reject-200
^https?:\/\/pan\.baidu\.com\/queryintent\/queryhint - reject-200
^https?:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist - reject-dict
^https?:\/\/pan\.baidu\.com\/(buy\/ad\/analytics|api\/analytics) - reject-200
^https?:\/\/ndstatic\.cdn\.bcebos\.com\/activity\/welfare\/(js\/.+\.js|index\.html) - reject-200
^https?:\/\/staticsns\.cdn\.bcebos\.com\/amis\/.+\/banner\.png - reject-img
^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/.*(guanggao|splash|advert|\/ad\/) - reject-img

[Script]
baidunetdisk_splash = type=http-request,pattern=^https?:\/\/pan\.baidu\.com\/.*(pcs\/adx?|membership\/advertise|splash|buy\/ad\/(conf|get)|api\/ad\/|act\/(api\/activityentry|v\d\/(bchannel|welfare)\/list)|feed\/cardinfos|recommend\/shortseries\/list),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/baidunetdisk.js,requires-body=0,timeout=10,script-update-interval=86400
baidunetdisk_clean = type=http-response,pattern=^https?:\/\/pan\.baidu\.com\/(api\/(getsyscfg|getconfig)|feed\/|act\/|pmall\/|.*(welfare|bchannel|pcs\/ad)),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/baidunetdisk.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% pan.baidu.com, ndstatic.cdn.bcebos.com, staticsns.cdn.bcebos.com, issuecdn.baidupcs.com
