#!name=百度贴吧净化
#!desc=去除贴吧开屏、首页推荐伪装广告贴、吧内商业贴、详情页直播推荐与插楼广告（JSON + Protobuf），精简我的页面、侧边栏与搜索热榜。若提示未登录，请关闭 HTTPS 解密里的“通过 HTTP/2 进行中间人攻击”。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.3 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,tiebac.baidu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,c.tieba.baidu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,tieba.baidu.com)),REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/tiebac\.baidu\.com\/c\/s\/log - reject-200
^https?:\/\/tiebac\.baidu\.com\/c\/f\/forum\/getInterestClassList$ - reject-dict
^https?:\/\/(tiebac|tieba)\.baidu\.com\/c\/f\/search\/discover$ - reject-dict
^https?:\/\/tieba\.baidu\.com\/c\/f\/forum\/getForumAlbum$ - reject-dict
^http:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/hotforum$ - reject-dict

[Body Rewrite]
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ '(. as $o | try (del(.url_map, .user_agent_info, .bubble_info, .duxiaoman_entry, .uc_card, .finance_tab, .vip_banner, .ala_live_info, .recom_naws_list, .duxiaoman, .namoaixud_entry)) catch $o) | (. as $o | try (del(.user.consume_info)) catch $o) | (. as $o | try (if (.user.shake_ad_switch | type) == "object" and (.user.shake_ad_switch | has("is_show")) then .user.shake_ad_switch.is_show = 0 else . end) catch $o) | (. as $o | try (.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事"))) catch $o) | (. as $o | try (.zone_info |= map(if (.common_func.common_func_noraml | type) == "array" then .common_func.common_func_noraml |= map(select(.name != "创建智能体")) else . end)) catch $o) | (. as $o | try (.zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))) catch $o)'
http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/forum\/forumGuide$ '(. as $o | try (del(.hot_search)) catch $o)'
http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/frs\/frsBottom\? '(. as $o | try (del(.card_activity)) catch $o)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/frs\/frsBottom$ '(. as $o | try (del(.card_activity)) catch $o)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/sidebar\/home$ '(. as $o | try (del(.game_center, .task_list, .vip_banner)) catch $o)'
http-response-jq ^https?:\/\/tieba\.baidu\.com\/mo\/q\/search\/startPage\? '(. as $o | try ({"no": 0, "error": "success"}) catch $o)'

[Script]
tieba_json = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-json.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
tieba_proto = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-proto.js,requires-body=1,max-size=1048576,binary-body-mode=1,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba.baidu.com, tieba.baidu.com
