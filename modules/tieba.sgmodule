#!name=百度贴吧净化
#!desc=去除贴吧开屏、首页推荐伪装广告贴、吧内商业贴、详情页直播推荐与插楼广告（JSON + Protobuf）。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.1.0 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,tiebac.baidu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,c.tieba.baidu.com)),REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/tiebac\.baidu\.com\/c\/s\/log - reject-200

[Script]
tieba_json = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-json.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
tieba_proto = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-proto.js,requires-body=1,max-size=1048576,binary-body-mode=1,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba.baidu.com
