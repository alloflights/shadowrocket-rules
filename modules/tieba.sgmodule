#!name=百度贴吧全能净化 (Tieba Pro)
#!desc=屏蔽贴吧开屏广告、首页推荐伪装广告贴(excellent/personalized)、吧内商业贴、详情页直播推荐与底层HTTPDNS
#!author=app2smile
#!system=ios
#!category=应用净化

[Rule]
DOMAIN,180.76.76.200,REJECT
IP-CIDR,180.76.76.200/32,REJECT,no-resolve

[URL Rewrite]
^https?:\/\/180\.76\.76\.200\/ - reject
^https?:\/\/tiebac\.baidu\.com\/c\/s\/log - reject-200

[Script]
贴吧_JSON = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/(c\/(s\/sync|f\/(ad\/getSplashAd|frs\/(page|threadlist|generalTabList)|pb\/(pic)?page|excellent\/personalized))$|tiebaads\/commonbatch\?),requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-json.js,script-update-interval=0
贴吧_Proto = type=http-response,pattern=^https?:\/\/(tiebac|c\.tieba)\.baidu\.com\/c\/(b\/ad\/adBid|f\/(frs\/(page|threadlist|generalTabList)|ad\/getFeedAd|pb\/page|excellent\/personalized))\?cmd,requires-body=1,binary-body-mode=1,max-size=-1,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/tieba-proto.js,script-update-interval=0

[MITM]
hostname = %APPEND% tiebac.baidu.com, c.tieba.baidu.com
