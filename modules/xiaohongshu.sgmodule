#!name=小红书净化
#!desc=去除小红书开屏、信息流赞助卡片、详情页小部件与营销弹窗，保存图片 / 实况时去水印。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,edith.xiaohongshu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,www.xiaohongshu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,ci.xiaohongshu.com)),REJECT

[URL Rewrite]
^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark - reject-img
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(get_style|open|submit_action) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v3\/note\/guide\? - reject-dict
^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? - reject-dict
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/(v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) - reject-dict

[Script]
xiaohongshu_purify = type=http-response,pattern=^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/(note\/(imagefeed|feed|videofeed|widgets|live_photo\/save|detail)|homefeed|system_service\/(splash_config|config)|search\/(banner|hot)_list|search\/notes|followfeed),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/xiaohongshu.js,requires-body=1,max-size=2097152,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com, ci.xiaohongshu.com
