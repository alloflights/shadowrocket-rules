#!name=小红书净化 (Xiaohongshu)
#!desc=去除小红书开屏广告、信息流赞助推广卡片、惊喜盒子弹窗与搜索热词
#!system=ios
#!category=应用净化

[URL Rewrite]
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/surprisebox\/(get_style|open|submit_action) - reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? - reject-dict
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v3\/note\/guide\? - reject-dict
^https:\/\/www\.xiaohongshu\.com\/api\/sns\/(v1\/ads\/resource|v2\/hey\/\w+\/hey_gallery) - reject-dict

[Script]
小红书_信息流 = type=http-response,pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v6\/homefeed\?,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/lalifeier/Shadowrocket/main/QuanX/Scripts/xiaohongshu.js
小红书_开屏 = type=http-response,pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/system_service\/splash_config,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/lalifeier/Shadowrocket/main/QuanX/Scripts/xiaohongshu.js
小红书_热搜 = type=http-response,pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/(banner|hot)_list,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/lalifeier/Shadowrocket/main/QuanX/Scripts/xiaohongshu.js

[MITM]
hostname = %APPEND% edith.xiaohongshu.com, www.xiaohongshu.com
