#!name=肯德基净化
#!desc=去除肯德基 App 开屏、首页营销弹窗与 AI 动态弹窗。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.1 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,res.kfc.com.cn)),REJECT
DOMAIN,dynamicad.kfc.com.cn,REJECT

[URL Rewrite]
^https?:\/\/res\.kfc\.com\.cn\/(advertisement|CRM\/kfcad)\/ - reject-200

[MITM]
hostname = %APPEND% res.kfc.com.cn
