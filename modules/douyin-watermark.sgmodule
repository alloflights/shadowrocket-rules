#!name=抖音无水印直存与评论区保护模块 (Douyin Safe Watermark-Free Pro)
#!desc=【评论区 100% 正常】严禁解密抖音 App 内部强证书绑定域名(amemv/snssdk)以保障评论区与推荐流零断连；拦截 Safari 打开的抖音分享链接(v.douyin.com / iesdouyin.com / douyin.com)，顶部直接弹出 1080P 无水印视频下载与全部原画图集长按保存面板
#!author=allofights
#!system=ios
#!category=应用增强

[Rule]
# 仅在网络层拦截穿山甲与电商小黄车域名，绝不阻断抖音核心 QUIC/HTTPDNS，保障评论区秒开
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle-ads.com,REJECT
DOMAIN-SUFFIX,ecombdapi.com,REJECT
DOMAIN-SUFFIX,ecombdpage.com,REJECT

[Script]
# 拦截 Safari 打开的抖音分享短链落地页 (iesdouyin.com / m.douyin.com / www.douyin.com)，自动注入顶部无水印视频与原图直存面板
抖音_分享页无水印直存 = type=http-response,pattern=^https?:\/\/(www\.iesdouyin|m\.douyin|www\.douyin)\.com\/(share\/(video|note|slides)|video|note)\/,requires-body=1,max-size=5242880,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/douyin-web.js,script-update-interval=0

[MITM]
# 关键：显式排除 -*.amemv.com 与 -*.snssdk.com 严防触发抖音 App Cronet 证书校验导致评论区打不开；仅解密网页分享端域名
hostname = %APPEND% -*.amemv.com, -*.snssdk.com, www.iesdouyin.com, m.douyin.com, www.douyin.com
h2 = true
