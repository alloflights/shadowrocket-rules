#!name=抖音无水印直存说明与保护 (Douyin Safe Guard)
#!desc=安全保护模块：已全面撤销对抖音核心域名(*.amemv.com / *.snssdk.com)的 MITM 解密，彻底保障评论区、直播与交互功能正常加载。抖音无水印下载请使用官方原生的免解密快捷指令方案。
#!author=allofights
#!system=ios
#!category=应用增强

[MITM]
# 显式解除中间人解密，避免底层 SSL Pinning 破坏评论区与通信
hostname = %APPEND% -*.amemv.com, -*.snssdk.com, -*.douyin.com
