#!name=哔哩哔哩净化 (Bilibili Pro)
#!desc=去除B站开屏广告、首页推荐流广告、动态列表推广与视频播放页UP主带货广告
#!author=app2smile
#!system=ios
#!category=应用净化

[Script]
bili_json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show)|feed\/index\?)|resource\/show\/tab\/v2),requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/bilibili-json.js,script-update-interval=0
bili_proto = type=http-response,pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/View$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/bilibili-proto.js,script-update-interval=0

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net
