#!name=哔哩哔哩净化
#!desc=去除 B 站开屏（含品牌 / 事件开屏）、首页推荐流广告、顶栏多余 Tab、播放页广告卡片。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.5 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,app.bilibili.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,grpc.biliapi.net)),REJECT

[Script]
bili_json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show|brand\/list|event\/list2)|feed\/index\?)|resource\/show\/tab\/v2),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/bilibili-json.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400
bili_proto = type=http-response,pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.viewunite\.v1\.View\/View$,script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/bilibili-proto.js,requires-body=1,max-size=1048576,binary-body-mode=1,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net
