#!name=Safari 网页去打扰
#!desc=解除知乎、CSDN、贴吧、微博移动网页的“打开 App 查看”遮罩并自动展开全文。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=浏览增强
#!system=ios
# v3.3.6 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,m.zhihu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,blog.csdn.net)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,tieba.baidu.com)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,m.weibo.cn)),REJECT

[Script]
safari_clean = type=http-response,pattern=^https?:\/\/(m\.zhihu\.com\/(question\/\d+|p\/\d+)|blog\.csdn\.net\/\w+\/article\/details\/\d+|tieba\.baidu\.com\/p\/\d+|m\.weibo\.cn\/detail\/\d+),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/safari-clean.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% m.zhihu.com, blog.csdn.net, tieba.baidu.com, m.weibo.cn
