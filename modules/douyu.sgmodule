#!name=斗鱼净化
#!desc=去除斗鱼开屏广告、直播间挂件与入口推广、首页活动悬浮、带货与游戏推广开关；阻断 P2P 上传 STUN 与连麦调度。
#!author=alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.10 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,rtbapi.douyucdn.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,apiv2.douyucdn.cn)),REJECT
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,venus.douyucdn.cn)),REJECT
URL-REGEX,"^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list",REJECT
DOMAIN,stun1.douyucdn.cn,REJECT
DOMAIN,stun1.qvb.qcloud.com,REJECT

[URL Rewrite]
^https:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo - reject-dict

[Body Rewrite]
http-response-jq ^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list '(. as $o | try (del(.data.pendant_a, .data.entrance_d)) catch $o)'
http-response-jq ^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config '(. as $o | try (reduce ("greatGodGameSitterSwitch", "followMoreAnchorEntrance", "sdklivebanner", "homeActFloatSwitch", "bringGoodsSwitch", "qqGameSwitch") as $k (.; if has($k) then .[$k] = 0 else . end)) catch $o)'

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
