#!name=喜马拉雅净化
#!desc=去除喜马拉雅开屏、首页轮播 / 直播 / 动态推广、福利中心与各类弹窗、搜索热词。
#!author=ddgksf2013,alloflights
#!homepage=https://github.com/alloflights/shadowrocket-rules
#!category=去广告
#!system=ios
# v3.3.5 · 由 scripts/build.js 自动生成，请勿直接修改

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,ximalaya.com)),REJECT
DOMAIN-SUFFIX,adse.ximalaya.com,REJECT
DOMAIN-SUFFIX,adse.wsa.ximalaya.com,REJECT
DOMAIN-SUFFIX,adbehavior.ximalaya.com,REJECT
DOMAIN-SUFFIX,xdcs-collector.ximalaya.com,REJECT

[URL Rewrite]
^https?:\/\/.*\.xima.*\.com\/.*(adse|adRealTime|ting\/(loading|feed|home|preload)|outadservice) - reject
^https?:\/\/.*\.xima.*\.com\/discovery-feed\/(focus\/queryF|isShowUserGiftPendant) - reject
^https?:\/\/passport\.ximalaya\.com\/friendship-mobile\/v1\/findFriendsBanner - reject
^https?:\/\/.*\.xima.*\.com\/mobile-playpage\/view\/ - reject
^https?:\/\/.*\.xima.*\.com\/chaos-notice-web\/v1\/message\/preview\/list - reject
^https?:\/\/.*\.xima.*\.com\/social-web\/bottomTabs\/dynamicEntrance\/status - reject
^https?:\/\/gslb.*\.xima.*\.com\/ - reject
^https?:\/\/.*\.xima.*\.com\/(dog-portal\/checkOld|(child-mobile\/child|aged-mobile\/aged)\/mode\/query) - reject
^https?:\/\/.*\.xima.*\.com\/mobile-user\/(unread|minorProtection\/pop) - reject
^https?:\/\/.*\.xima.*\.com\/collector\/xl\/v\d - reject
^https?:\/\/.*\.xima.*\.com\/butler-portal\/versionCheck - reject
^https?:\/\/.*\.xima.*\.com\/mobile\/discovery\/v\d\/location - reject
^https?:\/\/.*\.xima.*\.com\/(hub\/)?(hotWord|hotWordBillboard|guideWord) - reject

[Script]
ximalaya_clean = type=http-response,pattern=^https?:\/\/.*\.xima.*\.com\/(discovery-category\/(customCategories|v\d\/category)|focus-mobile\/focusPic|discovery-feed\/v\d\/mix|mobile-user\/v\d\/homePage),script-path=https://cdn.jsdelivr.net/gh/alloflights/shadowrocket-rules@main/modules/scripts/ximalaya_json.js,requires-body=1,max-size=1048576,timeout=10,script-update-interval=86400

[MITM]
hostname = %APPEND% *.ximalaya.com
